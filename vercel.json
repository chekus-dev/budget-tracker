{
  "services": {
    "budget-tracker": {
      "root": ".",
      "framework": "Go",
      "runtime": "Go",
      "buildCommand": "npm ci && npm run build:css && go build -o app ."
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "budget-tracker"
      }
    }
  ]
}